# Calc — Nginx для поддомена calc.loomixx.ru (корень домена, Vite base: '/')
#
# Отдельный server block — не трогать конфиги других проектов.
# Диск: статика /var/www/calc/dist | PB /opt/pocketbase-calc → 127.0.0.1:8095
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/calc.loomixx.ru
#   sudo ln -sf /etc/nginx/sites-available/calc.loomixx.ru /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d calc.loomixx.ru

upstream pocketbase_calc {
    server 127.0.0.1:8095;
    keepalive 32;
}

server {
    listen 80;
    server_name calc.loomixx.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name calc.loomixx.ru;

    # ssl_certificate / ssl_certificate_key — certbot

    root /var/www/calc/dist;
    index index.html;

    # SW / HTML / manifest / workbox — no-cache (иначе PWA год держит старый SW)
    location = /sw.js {
        add_header Cache-Control "no-cache" always;
    }
    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache" always;
        default_type application/manifest+json;
    }
    location ~* ^/workbox-[^/]+\.js$ {
        add_header Cache-Control "no-cache" always;
    }

    # Хэшированные ассеты Vite
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }

    # PocketBase API (same-origin → CORS не нужен)
    location /api/ {
        proxy_pass http://pocketbase_calc/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 100M;
    }

    # PocketBase Admin UI
    location /_/ {
        proxy_pass http://pocketbase_calc/_/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA
    location / {
        try_files $uri $uri/ /index.html;
    }
}
